{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-module" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="alert alert-info"><i class="fa-solid fa-circle-info"></i> {{ text_help }}</div>
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-module" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="module_keyword_suggest_status" value="0"/>
                <input type="checkbox" name="module_keyword_suggest_status" value="1" id="input-status" class="form-check-input"{% if module_keyword_suggest_status %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_engines }}</label>
            <div class="col-sm-10">
              <div class="form-control" style="height:auto">
                {% for id, engine in engines %}
                  <div class="form-check form-check-inline" style="min-width:10em">
                    <input type="checkbox" name="module_keyword_suggest_engines[]" value="{{ id }}" id="input-engine-{{ id }}" class="form-check-input"{% if id in module_keyword_suggest_engines %} checked{% endif %}/>
                    <label for="input-engine-{{ id }}" class="form-check-label">{{ engine.label }} <small class="text-muted">({{ engine.group }})</small></label>
                  </div>
                {% endfor %}
              </div>
              <div class="form-text">{{ entry_engines_help }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-locale" class="col-sm-2 col-form-label">{{ entry_locale }}</label>
            <div class="col-sm-10">
              <select name="module_keyword_suggest_locale" id="input-locale" class="form-select">
                {% for code in locales %}
                  <option value="{{ code }}"{% if code == module_keyword_suggest_locale %} selected{% endif %}>{{ code }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-limit" class="col-sm-2 col-form-label">{{ entry_limit }}</label>
            <div class="col-sm-10">
              <input type="number" name="module_keyword_suggest_limit" value="{{ module_keyword_suggest_limit }}" min="3" max="25" id="input-limit" class="form-control"/>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
